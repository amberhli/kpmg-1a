   "id": "08159105",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "%matplotlib inline\n",
    "import matplotlib.pyplot as plt \n",
    "import seaborn as sns\n",
    "\n",
    "import re"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fa9535a1",
   "metadata": {},
   "source": [
    "General script for downloading data, removing informationless features (no variation), renaming columns, and flagging the upgrade #"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "fb758fc1",
   "metadata": {},
   "outputs": [],
   "source": [
    "def regex_rename(df):\n",
    "    def rename_col(col):\n",
    "        col = re.sub(r'^out\\.', '', col)\n",
    "        col = re.sub(r'\\.energy_consumption\\.kwh', '', col)\n",
    "        col = col.replace('.', '_')\n",
    "        return col\n",
    "    df = df.rename(columns={col: rename_col(col) for col in df.columns})\n",
    "    return df\n",
    "\n",
    "def load_data(fn):\n",
    "    df = pd.read_csv(fn)\n",
    "    df = df.drop(columns=['in.state', 'in.comstock_building_type', 'models_used', 'floor_area_represented'])\n",
    "    df['timestamp'] = pd.to_datetime(df['timestamp'])\n",
    "    df = regex_rename(df)\n",
    "    return df"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "a19ffae7",
   "metadata": {},
   "outputs": [],
   "source": [
    "raw_folder = os.path.join(\"..\", \"data\", \"nrel\", \"raw\")\n",
    "\n",
    "fn0 = os.path.join(raw_folder, \"up00-ny-largeoffice.csv\")\n",
    "fn1 = os.path.join(raw_folder, \"up01-ny-largeoffice.csv\")\n",
    "fn2 = os.path.join(raw_folder, \"up02-ny-largeoffice.csv\")\n",
    "\n",
    "df0 = load_data(fn0)\n",
    "df1 = load_data(fn1)\n",
    "df2 = load_data(fn2)"
   ]
  },
